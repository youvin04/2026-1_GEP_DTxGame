  levelIndex: 4
  levelTitle: LEVEL.5
  npcName: "\uD48D\uB144\uB5A1\uC9D1 \uC0AC\uC7A5\uB2D8"
  npcSprite: {fileID: 0}
  cutsceneDialogues:
  - "\uBAA8\uB4E0 \uB2E8\uC11C\uAC00 \uB5A1\uC9D1\uC744 \uAC00\uB9AC\uD0A4\uACE0
    \uC788\uC5B4."
  - "\uD560\uBA38\uB2C8 \uC2EC\uBD80\uB984\uB3C4 \uD655\uC778\uD560 \uACB8..."
  - "\uC9C4\uC2E4\uC744 \uBC1D\uD600\uB0BC \uB9C8\uC9C0\uB9C9 \uAE30\uD68C\uB2E4."
  npcSystemPrompt: "\uB2F9\uC2E0\uC740 \uCDA9\uCCAD\uB3C4 \uC0AC\uD22C\uB9AC\uB97C
    \uC4F0\uB294 \uD48D\uB144\uB5A1\uC9D1 \uC0AC\uC7A5\uB2D8\uC785\uB2C8\uB2E4. \uD560\uBA38\uB2C8\uC758
    \uAFC0\uB5A1 2\uB418 \uC8FC\uBB38\uC744 \uD655\uC778\uD574\uC8FC\uB294 \uCE5C\uC808\uD55C
    \uB3D9\uB124 \uB5A1\uC9D1 \uC0AC\uC7A5\uB2D8\uC785\uB2C8\uB2E4. \uD50C\uB808\uC774\uC5B4\uAC00
    \uC218\uC0C1\uD55C \uC9C8\uBB38\uC744 \uD574\uB3C4 \uC790\uC5F0\uC2A4\uB7FD\uAC8C
    \uACE0\uC591\uC774 \uAD6C\uCD9C \uC774\uC57C\uAE30\uB85C \uB118\uC5B4\uAC00\uC8FC\uC138\uC694.
    \uC751\uB2F5\uC740 2~3\uBB38\uC7A5\uC73C\uB85C \uC9E7\uAC8C \uD574\uC8FC\uC138\uC694."
  callDescription: "*\uD48D\uB144\uB5A1\uC9D1\uC758 \uC5F0\uB77D. \uD560\uBA38\uB2C8\uC758
    \uB5A1 \uC8FC\uBB38 \uD655\uC778\uCC28 \uB5A1\uC9D1 \uC0AC\uC7A5\uB2D8\uC774
    \uBA3C\uC800 \uC804\uD654\uB97C \uAC78\uC5B4\uC654\uB2E4. \uBBF8\uC158: \uAFC0\uB5A1
    2\uB418, \uD1A0\uC694\uC77C \uC624\uD6C4 2\uC2DC, \uD560\uBA38\uB2C8 \uC131\uD568
    \uAE30\uC7AC \uC5EC\uBD80\uB97C \uD655\uC778\uD560 \uAC83."
  endingDialogues:
  - "\uC7A0\uAE50... \uACE0\uC591\uC774 \uAD6C\uCD9C \uC791\uC804?"
  - "\uCE58\uD0A8\uC9D1 \uBBF8\uB07C\uB294 \uB2ED\uAC00\uC2B4\uC0B4\uC774\uC5C8\uACE0..."
  - "\uC790\uB8E8\uC640 \uBC27\uC904\uC740 \uAD6C\uCD9C \uC7A5\uBE44\uC600\uACE0..."
  - "\uADF8\uB9AC\uACE0 \uB5A1\uC740... \uCD95\uD558 \uCF00\uC774\uD06C\uC600\uAD6C\uB098."
  - "\uB098 \uD63C\uC790 \uD0D0\uC815 \uB180\uC774\uB97C \uD588\uB358 \uAC70\uC57C?"
